# OXOXOS API configuration
# Create a token at https://api.oxoxos.com/console/token
OXOXOS_BASE_URL=https://api.oxoxos.com/v1
OXOXOS_API_KEY=YOUR_OXOXOS_API_KEY

# Optional branding/portal overrides for forks. Leave empty for the official service.
# OXOXOS_BRAND_NAME=OXOXOS
# OXOXOS_PORTAL_URL=https://api.oxoxos.com
# OXOXOS_TOKEN_URL=https://api.oxoxos.com/console/token

# Optional. Leave model ids empty to discover current marketplace models at runtime.
OXOXOS_IMAGE_MODEL=
OXOXOS_VISION_MODEL=

# Optional local HTTP proxy, for example http://127.0.0.1:7890
OXOXOS_PROXY=

# Deprecated compatibility aliases (remove after migrating existing installs):
# QWAPI_BASE_URL=
# QWAPI_API_KEY=
# QWAPI_IMAGE_MODEL=
# QWAPI_VISION_MODEL=
# QWAPI_PROXY=
